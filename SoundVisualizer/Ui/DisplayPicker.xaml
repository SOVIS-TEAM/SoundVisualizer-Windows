<UserControl x:Class="SoundVisualizer.Ui.DisplayPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:SoundVisualizer.Localization"
             xmlns:ui="clr-namespace:SoundVisualizer.Ui"
             FontSize="14" FontWeight="Normal" Foreground="{StaticResource PrimaryTextBrush}">

    <!-- 오버레이를 표시할 모니터를 선택하는 칸(#29). 쉬운 설정과 자세한 설정에 하나씩 놓인다. 모니터가 두 대 이상일 때만 둘러싼 구역이 보인다
         (HasChoices 를 보고 놓은 쪽이 접는다). 칸은 연결된 모니터마다 하나이고 코드(Reload)가 만든다.
         칸의 차례는 모니터가 놓인 차례(왼쪽에서 오른쪽)라서, 오른쪽에서 왼쪽으로 쓰는 언어에서도 줄을 뒤집지 않는다. 글자만 그 언어의 방향을 따른다. -->
    <UserControl.Resources>
        <!-- 체크 표시. 고른 칸은 색에 더해 이 표시로도 보인다(쉬운 설정의 칸과 같다). 뒤집으면 꺾인 화살표처럼 보여 어느 언어에서도 뒤집지 않는다. -->
        <Style x:Key="CheckMark" TargetType="Path">
            <Setter Property="FlowDirection" Value="LeftToRight"/>
            <Setter Property="Data" Value="M 0,5 L 4,9 L 12,1"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <!-- 모니터 칸: 배치 그림, 이름("모니터 2"), 해상도, 주 모니터 표시. 고른 칸은 강조 바탕에 흰 글자와 이름 앞 체크 표시,
             나머지는 조작 요소 바탕에 본 글자다(쉬운 설정의 모양 카드와 같은 색). 화면 읽어주기에는 칸 하나로 읽히고 이름은 코드가 단다. -->
        <Style x:Key="DisplayCard" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chip" Background="{StaticResource ControlBrush}" CornerRadius="14" Padding="10,12">
                            <StackPanel FlowDirection="{Binding FlowDirection, Source={x:Static l:Loc.Instance}}">
                                <ui:DisplayLayoutIcon HorizontalAlignment="Center" Foreground="{TemplateBinding Foreground}"
                                                      Displays="{Binding Tag.All, RelativeSource={RelativeSource TemplatedParent}}"
                                                      Display="{Binding Tag.Display, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <Grid HorizontalAlignment="Center" MinHeight="28" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path x:Name="Check" Style="{StaticResource CheckMark}" Margin="0,0,6,0" Stroke="{TemplateBinding Foreground}"/>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                                               Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"/>
                                </Grid>
                                <!-- 해상도는 숫자뿐이라 어느 언어에서도 왼쪽에서 오른쪽으로 적는다. 아랍어의 흐름을 따르면 "1080 × 1920" 으로 보인다. -->
                                <TextBlock FontSize="13" FontWeight="Normal" TextWrapping="Wrap" TextAlignment="Center" FlowDirection="LeftToRight"
                                           Text="{Binding Tag.Size, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <!-- 주 모니터가 아닌 칸은 이 줄이 비어 있다. 한 줄 안의 칸은 높이를 맞추므로(EqualChoicePanel) 칸 크기는 같다. -->
                                <TextBlock FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,2,0,0"
                                           Text="{Binding Tag.PrimaryText, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource ControlHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource AccentFillBrush}"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource OnFillBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource AccentFillHoverBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DisplayCards" TargetType="ListBox" BasedOn="{StaticResource ChoiceChips}">
            <Setter Property="FlowDirection" Value="LeftToRight"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DisplayCard}"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <ui:EqualChoicePanel Gap="10"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <ui:ChoiceChipList x:Name="Cards" Style="{StaticResource DisplayCards}" SelectionChanged="Cards_SelectionChanged"/>
        <!-- 선택해 둔 모니터가 지금 연결되어 있지 않을 때만 보인다. 그때는 어느 칸도 선택해 두지 않는다. 나타나면 화면 읽어주기가
             읽고 지나간다(코드의 AnnounceMissing 이 알린다. LiveSetting 만으로는 읽지 않는다). -->
        <TextBlock x:Name="TxtMissing" Style="{StaticResource Text.Description}" Margin="0,12,0,0" Visibility="Collapsed"
                   AutomationProperties.LiveSetting="Polite" Text="{l:Loc settings.display.missing}"/>
    </StackPanel>
</UserControl>
