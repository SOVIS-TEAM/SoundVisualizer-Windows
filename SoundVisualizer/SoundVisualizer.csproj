<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>SoundVisualizer.ico</ApplicationIcon>
    <!-- 도움말의 앱 정보와 제보의 환경 정보가 이 값을 읽는다. 배포할 때마다 올린다. -->
    <Version>2.3.4</Version>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="SoundVisualizer.ico" />
  </ItemGroup>

  <!-- Pretendard (SIL OFL 1.1). 글꼴은 실행 파일에 넣고, OFL 은 글꼴과 함께 배포해야 하므로 라이선스 파일을 출력 폴더에 둔다. -->
  <ItemGroup>
    <Resource Include="Fonts\Pretendard-*.otf" />
    <None Include="Fonts\Pretendard-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 튜토리얼 소리(CC0·퍼블릭 도메인, 출처는 THIRD_PARTY.md 의 Tutorial sounds). 안드로이드의 Ogg 조각을 한 번 풀어 둔 PCM WAV 다.
       Ogg 를 앱에서 풀려면 디코더 라이브러리가 더 필요해, 풀어 둔 파일(모노 16비트, 넷 합쳐 약 470KB)을 실행 파일에 넣는다. -->
  <ItemGroup>
    <Resource Include="Tutorial\Sounds\*.wav" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.3" />
    <PackageReference Include="NAudio" Version="2.3.0" />
  </ItemGroup>

  <!--
    포터블 판(GitHub zip, #58): `dotnet publish -p:Portable=true`(packaging/portable/build-portable.ps1).
    실행 파일 하나만 있어도 켜지게 그래픽·AI 엔진 DLL 과 AI 모델을 실행 파일에 넣는다. DLL 은 켤 때 .NET 이 %TEMP%\.net 에 풀어 쓰고,
    모델은 AppModels 가 쓰기 직전에 임시 폴더에 꺼낸다. 실행 폴더(AppContext.BaseDirectory)는 그대로 exe 폴더다.
    그 밖의 빌드(Microsoft Store 의 MSIX, 개발 빌드, 시험)는 지금처럼 DLL 과 AIModel 폴더를 실행 파일 옆에 둔다.
  -->
  <PropertyGroup Condition="'$(Portable)' == 'true'">
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup Condition="'$(Portable)' == 'true'">
    <!-- 리소스 이름은 BundledModels.ResourcePrefix("AIModel/") + 파일 이름이다. -->
    <EmbeddedResource Include="AIModel\yamnet.onnx;AIModel\yamnet.data;AIModel\yamnet_class_map.csv;AIModel\silero_vad.onnx" LogicalName="AIModel/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup Condition="'$(Portable)' != 'true'">
    <None Update="AIModel\yamnet.onnx">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="AIModel\yamnet.data">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="AIModel\yamnet_class_map.csv">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <!-- 말소리 미리보기의 Silero VAD(MIT, 고지는 THIRD_PARTY.md). 다른 모델처럼 실행 파일 옆 AIModel 에 둔다. -->
    <None Update="AIModel\silero_vad.onnx">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SoundVisualizer.Core\SoundVisualizer.Core.csproj" />
  </ItemGroup>

</Project>
